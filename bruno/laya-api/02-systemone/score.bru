meta {
  name: systemone - score
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/systemone
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "state": "This is extremely urgent, we need help right now!",
    "questions": {
      "urgency": {
        "type": "score",
        "instructions": "How urgent is this?",
        "criteria": ["not urgent", "soon", "critical"]
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.answers.urgency.score: isDefined
  res.body.answers.urgency.probabilities: isDefined
}
